<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:VSuiteLab.Views"
        xmlns:vm="clr-namespace:VSuiteLab.ViewModels"
        xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
        xmlns:models="clr-namespace:VSuiteLab.Models"
        xmlns:converters="clr-namespace:VSuiteLab.Converters"
        xmlns:windows="clr-namespace:VSuiteLab.Views.Windows"
        x:Class="VSuiteLab.Views.Windows.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Width="1100" Height="700"
        mc:Ignorable="d"
        Title="VSuite Lab">

    <Window.DataContext>
        <vm:MainWindowViewModel />
    </Window.DataContext>

    <Window.DataTemplates>
        <DataTemplate DataType="converters:TextEditorVm">
            <TextBox Text="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        </DataTemplate>

        <DataTemplate DataType="converters:NumberEditorVm">
            <NumericUpDown Value="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        </DataTemplate>

        <DataTemplate DataType="converters:BoolEditorVm">
            <CheckBox IsChecked="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        </DataTemplate>

        <DataTemplate DataType="converters:DateEditorVm">
            <DatePicker SelectedDate="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        </DataTemplate>

        <DataTemplate DataType="converters:EnumEditorVm">
            <ComboBox ItemsSource="{Binding Values}"
                      SelectedItem="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        </DataTemplate>
    </Window.DataTemplates>
    
    <Window.KeyBindings>
        <KeyBinding Gesture="F1" Command="{Binding OpenHelpCommand}" />
        <KeyBinding Gesture="F5" Command="{Binding SyncCommand}" />
        <KeyBinding Gesture="F9" Command="{Binding OpenSettingsCommand}" />
    </Window.KeyBindings>

    <DockPanel>

        <!-- Top toolbar with TabControl -->
        <Border DockPanel.Dock="Top" Padding="5,0,5,0"
                Background="{DynamicResource SystemControlBackgroundBaseLowBrush}"
                Height="43">
            <Grid ColumnDefinitions="Auto,Auto,*,Auto">

                <!-- SEARCH + FILTER FLYOUT -->
                <StackPanel Orientation="Horizontal">

                    <!-- SEARCH BUTTON -->
                    <Button x:Name="SearchButton">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <materialIcons:MaterialIcon Kind="Search" />
                            <TextBlock Text="Search" />
                        </StackPanel>
                        <Button.Flyout>
                            <Flyout Placement="Bottom"
                                    ShowMode="Standard">

                                <!-- PANEL -->
                                <Border
                                    Padding="5"
                                    CornerRadius="10"
                                    BorderThickness="1">

                                    <StackPanel>

                                        <!-- HEADER -->
                                        <TextBlock Text="Filters"
                                                   FontSize="12"
                                                   Opacity="0.7"
                                                   Margin="4,0" />

                                        <!-- FILTERS -->
                                        <ItemsControl ItemsSource="{Binding QueryBuilder.Filters}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>

                                                    <Border CornerRadius="8"
                                                            Padding="7"
                                                            Margin="0,4"
                                                            Background="{DynamicResource SystemControlBackgroundBaseLowBrush}">

                                                        <Grid ColumnDefinitions="*,*,*,Auto"
                                                              ColumnSpacing="8">

                                                            <!-- FIELD -->
                                                            <ComboBox
                                                                ItemsSource="{Binding AvailableFields}"
                                                                SelectedItem="{Binding SelectedField, Mode=TwoWay}"
                                                                DisplayMemberBinding="{Binding Label}"  />

                                                            <!-- OPERATOR -->
                                                            <ComboBox Grid.Column="1"
                                                                      ItemsSource="{Binding AvailableSearchOperators}"
                                                                      SelectedItem="{Binding OperatorType}"
                                                                      Background="Transparent"
                                                                      BorderThickness="0" />

                                                            <!-- VALUE -->
                                                            <ContentControl Grid.Column="2"
                                                                            Content="{Binding Editor}" />

                                                            <!-- REMOVE -->
                                                            <Button Grid.Column="3"
                                                                    Content="✕"
                                                                    Background="Transparent"
                                                                    BorderThickness="0"
                                                                    Opacity="0.6"
                                                                    Command="{Binding $parent[Window].DataContext.RemoveFilterCommand}"
                                                                    CommandParameter="{Binding}" />

                                                        </Grid>
                                                    </Border>

                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <!-- ADD FILTER -->
                                        <Button Content="+ Add filter"
                                                Command="{Binding AddFilterCommand}"
                                                HorizontalAlignment="Left"
                                                Padding="10,4"
                                                Background="Transparent"
                                                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                                                BorderThickness="1"
                                                CornerRadius="6" />

                                        <TextBlock Text="Sorts"
                                                   FontSize="12"
                                                   Opacity="0.7"
                                                   Margin="4,10,4,0" />

                                        <ItemsControl ItemsSource="{Binding QueryBuilder.Sorts}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>

                                                    <Border CornerRadius="8"
                                                            Padding="7"
                                                            Margin="0,4"
                                                            Background="{DynamicResource SystemControlBackgroundBaseLowBrush}">
                                                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">

                                                            <!-- FIELD -->
                                                            <ComboBox
                                                                ItemsSource="{Binding AvailableFields}"
                                                                SelectedItem="{Binding SelectedField}"
                                                                DisplayMemberBinding="{Binding Label}" />

                                                            <!-- DESC -->
                                                            <CheckBox Grid.Column="1"
                                                                      Content="Desc"
                                                                      IsChecked="{Binding Descending}" />

                                                            <!-- REMOVE -->
                                                            <Button Grid.Column="2"
                                                                    Content="✕"
                                                                    Command="{Binding $parent[Window].DataContext.RemoveSortCommand}"
                                                                    CommandParameter="{Binding}" />

                                                        </Grid>
                                                    </Border>

                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <Button Content="+ Add sort"
                                                Padding="10,4"
                                                Background="Transparent"
                                                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                                                BorderThickness="1"
                                                Command="{Binding AddSortCommand}" />

                                        <TextBlock Text="Groups"
                                                   FontSize="12"
                                                   Opacity="0.7"
                                                   Margin="4,10,4,0" />

                                        <ItemsControl ItemsSource="{Binding QueryBuilder.Groups}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>

                                                    <Border CornerRadius="8"
                                                            Padding="7"
                                                            Margin="0,4"
                                                            Background="{DynamicResource SystemControlBackgroundBaseLowBrush}">
                                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">

                                                            <!-- FIELD -->
                                                            <ComboBox
                                                                ItemsSource="{Binding AvailableFields}"
                                                                SelectedItem="{Binding SelectedField}"
                                                                DisplayMemberBinding="{Binding Label}" />

                                                            <!-- REMOVE -->
                                                            <Button Grid.Column="1"
                                                                    Content="✕"
                                                                    Command="{Binding $parent[Window].DataContext.RemoveGroupCommand}"
                                                                    CommandParameter="{Binding}" />

                                                        </Grid>
                                                    </Border>

                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <Button Content="+ Add group"
                                                Padding="10,4"
                                                Background="Transparent"
                                                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                                                BorderThickness="1"
                                                Command="{Binding AddGroupCommand}" />

                                    </StackPanel>

                                </Border>

                            </Flyout>
                        </Button.Flyout>

                    </Button>

                </StackPanel>

                <!-- Tabs -->
                <TabControl Grid.Column="1"
                            x:Name="MainTabs"
                            SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}">
                    <TabItem Header="Journals" />
                    <TabItem Header="Notes" />
                    <TabItem Header="Tasks" />
                </TabControl>

                <ToggleButton Grid.Column="2"
                              IsEnabled="{Binding HasSyncErrors}"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              Background="Transparent"
                              BorderBrush="Transparent">

                    <TextBlock Text="{Binding ActiveSync.Message, TargetNullValue=Idle}"
                               TextWrapping="Wrap" VerticalAlignment="Center" FontSize="10" />

                    <ToggleButton.Flyout>
                        <Flyout Placement="Bottom" ShowMode="Transient">
                            <Border Width="400" MaxHeight="300">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding SyncResults}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Padding="5"
                                                        Background="{Binding IsError}">

                                                    <StackPanel Spacing="4">
                                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                                            <TextBlock Text="{Binding ServerName}" FontWeight="Bold" />
                                                            <TextBlock Text="{Binding Timestamp}" FontSize="10" />
                                                        </StackPanel>

                                                        <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />

                                                        <Button Content="Retry"
                                                                Command="{Binding $parent[windows:MainWindow].DataContext.RetrySyncCommand}"
                                                                CommandParameter="{Binding}" />
                                                    </StackPanel>

                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Border>
                        </Flyout>
                    </ToggleButton.Flyout>

                </ToggleButton>

                <!-- Buttons -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8">
                    <SplitButton Command="{Binding SyncCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <materialIcons:MaterialIcon Kind="RemoteDesktop" />
                            <TextBlock Text="Sync" />
                        </StackPanel>
                        <SplitButton.Flyout>
                            <Flyout>
                                <ItemsControl ItemsSource="{Binding DavInstances}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="models:DavConfig">
                                            <Button
                                                Command="{Binding $parent[windows:MainWindow].DataContext.SyncDavItem}"
                                                CommandParameter="{Binding}">
                                                <TextBlock Text="{Binding Name}" Foreground="{Binding Color}"
                                                           FontWeight="Bold" />
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Flyout>
                        </SplitButton.Flyout>
                    </SplitButton>

                    <Button Command="{Binding OpenSettingsCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <materialIcons:MaterialIcon Kind="Settings" />
                            <TextBlock Text="Settings" />
                        </StackPanel>
                    </Button>
                    
                    <DropDownButton>
                        <DropDownButton.Content>
                            <Image Source="avares://VSuiteLab/Assets/avalonia-logo.ico" Height="21" />
                        </DropDownButton.Content>
                        <DropDownButton.Flyout>
                            <MenuFlyout>
                                <MenuItem Header="Help" Command="{Binding OpenHelpCommand}" />
                                <Separator />
                                <MenuItem Header="Source Code" Command="{Binding OpenSourceCommand}"/>
                                <MenuItem Header="Report bugs and feedback" Command="{Binding OpenIssuesCommand}" />
                                <MenuItem Header="Make a donation" Command="{Binding OpenDonateCommand}" />
                                <MenuItem Header="About VSuite Lab" Command="{Binding ShowAboutCommand}" />
                            </MenuFlyout>
                        </DropDownButton.Flyout>
                    </DropDownButton>
                </StackPanel>

            </Grid>
        </Border>

        <!-- Main content -->
        <ContentControl DockPanel.Dock="Bottom"
                        Content="{Binding SelectedTabContent}" />

    </DockPanel>
</Window>