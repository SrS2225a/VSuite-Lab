<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:VSuiteLab.ViewModels"
        x:DataType="vm:SplashViewModel"
        x:Class="VSuiteLab.Views.Windows.SplashWindow"
        Width="400" Height="200"
        CanResize="False"
        WindowStartupLocation="CenterScreen"
        SystemDecorations="None">

    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12">
        <TextBlock Text="VSuite Lab" FontSize="20" HorizontalAlignment="Center"/>
        <ProgressBar IsIndeterminate="True" Width="200"/>
        <TextBlock Text="{Binding Status}" HorizontalAlignment="Center"/>
    </StackPanel>
</Window>